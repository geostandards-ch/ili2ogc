INTERLIS 2.3;

!! INSPECTION OF a SURFACE attribute, both levels of eCH-0031 SS3.15's
!! predefined structures: `-> Geometrie` yields one SurfaceBoundary per
!! surface (here read as the boundary geometry, next to a PARENT-> field of
!! the owning object), `-> Geometrie -> Lines` one SurfaceEdge per boundary
!! line (the exterior ring and every hole), read through its `Geometry`.

MODEL TestInspectionSurfaceEdges AT "http://www.interlis.ch/ili2c/tests/" VERSION "1" =

  TOPIC Base =
    DOMAIN
      !!@CRS=EPSG:2056
      Coord2 = COORD 2500000.000 .. 2900000.000, 1000000.000 .. 1400000.000;
      Flaeche = SURFACE WITH (STRAIGHTS) VERTEX Coord2 WITHOUT OVERLAPS>0.001;

    CLASS Zone =
      Name: TEXT*40;
      Geometrie: MANDATORY Flaeche;
    END Zone;

    VIEW ZoneBoundary
      INSPECTION OF TestInspectionSurfaceEdges.Base.Zone -> Geometrie;
      =
      ATTRIBUTE
        Boundary := Zone -> Geometrie;
        OwnerName := PARENT -> Name;
    END ZoneBoundary;

    VIEW ZoneEdge
      INSPECTION OF TestInspectionSurfaceEdges.Base.Zone -> Geometrie -> Lines;
      =
      ATTRIBUTE
        Line := Zone -> Geometry;
    END ZoneEdge;
  END Base;

END TestInspectionSurfaceEdges.
