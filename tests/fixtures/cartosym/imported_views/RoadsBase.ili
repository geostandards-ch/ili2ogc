INTERLIS 2.4;

!! A base model with one class, for the views model that selects it.

MODEL RoadsBase (en)
AT "https://example.org/models/" VERSION "2026-11-20" =

  DOMAIN
    Coord2 = COORD 2460000.000 .. 2870000.000 [INTERLIS.m], 1045000.000 .. 1310000.000 [INTERLIS.m], ROTATION 2 -> 1;
    Line = POLYLINE WITH (STRAIGHTS) VERTEX Coord2;

  TOPIC Roads =

    CLASS Road =
      RoadKind : (main, side);
      Geometry : Line;
    END Road;

  END Roads;

END RoadsBase.
