INTERLIS 2.4;

!! A label made of two values: Number, and "." + Part when the part exists (DMAV: Grundstueck.Nummer . NummerTeilgrundstueck).
!! INTERLIS has no text concatenation, so the sign interface is extended (StandardSymbologyText) and two rules split the cases.
MODEL TextSuffixExample (en)
AT "https://example.org/models/" VERSION "2026-10-22" =
  IMPORTS StandardSymbologyText;

  DOMAIN
    Coord2 = COORD 2460000.000 .. 2870000.000 [INTERLIS.m], 1045000.000 .. 1310000.000 [INTERLIS.m], ROTATION 2 -> 1;

  TOPIC T =
    DEPENDS ON StandardSymbologyText.TextSigns;

    CLASS Parcel =
      Number : MANDATORY TEXT*12;
      Part : TEXT*12;
      Position : MANDATORY Coord2;
    END Parcel;

    SIGN BASKET Signs ~ StandardSymbologyText.TextSigns
      OBJECTS OF TextSign: ParcelLabel;

    GRAPHIC Numbers BASED ON Parcel =
      WithPart OF StandardSymbologyText.TextSigns.TextSign:
        WHERE DEFINED(Part) (
          Sign := {ParcelLabel};
          Txt := Number;
          Separator := ".";
          Suffix := Part;
          Geometry := Position;
          Priority := 1);
      WithoutPart OF StandardSymbologyText.TextSigns.TextSign:
        WHERE NOT (DEFINED(Part)) (
          Sign := {ParcelLabel};
          Txt := Number;
          Geometry := Position;
          Priority := 1);
    END Numbers;
  END T;
END TextSuffixExample.
